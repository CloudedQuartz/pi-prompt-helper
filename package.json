{
  "name": "pi-prompt-helper",
  "version": "0.1.0",
  "description": "A local pi extension that conservatively removes low-information prompt text.",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test:node": "npm run build:test && node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test": "npm run test:node && npm run test:python",
    "smoke": "node scripts/smoke-extension.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
